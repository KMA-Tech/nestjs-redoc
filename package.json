{
  "name": "@placesapp/nestjs-redoc",
  "version": "3.1.1",
  "description": "NestJS Redoc frontend — placesapp fork with NestJS 11 + Fastify 5 support",
  "author": "jason@placesapp.io",
  "contributors": [
    "Alfonso Reyes (https://github.com/mxarc)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KMA-Tech/nestjs-redoc.git"
  },
  "homepage": "https://github.com/KMA-Tech/nestjs-redoc#readme",
  "bugs": {
    "url": "https://github.com/KMA-Tech/nestjs-redoc/issues"
  },
  "keywords": [
    "nestjs",
    "redoc",
    "openapi",
    "swagger",
    "documentation",
    "fastify"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "views/",
    "README.md",
    "LICENSE"
  ],
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build": "tsc -p ./tsconfig.build.json",
    "format": "prettier --write \"./src/**/*.ts\"",
    "format:check": "prettier --check \"./src/**/*.ts\"",
    "lint": "eslint \"./src/**/*.ts\" --fix",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "sample": "ts-node ./sample/main"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/swagger": "^7.0.0 || ^8.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "dependencies": {
    "express-basic-auth": "1.2.1",
    "express-handlebars": "8.0.1",
    "joi": "17.13.3"
  },
  "devDependencies": {
    "@commitlint/cli": "19.6.0",
    "@commitlint/config-conventional": "19.6.0",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/platform-fastify": "11.1.6",
    "@nestjs/testing": "11.1.6",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.1",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "commitizen": "4.3.1",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "fastify": "5.4.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.0.1",
    "rxjs": "7.8.1",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
